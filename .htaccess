PassengerAppRoot "/home/olivian1/olivian"
PassengerBaseURI "/"
PassengerPython "/home/olivian1/virtualenv/olivian/3.11/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# ------------------------------------------------------------

# ------------------------------------------------------------
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
# ------------------------------------------------------------

# ------------------------------------------------------------
# MIME TYPE FIXES
# Ensure CSS and JS files are served with the correct MIME types
AddType text/css .css
AddType application/javascript .js

<FilesMatch "\.css$">
  ForceType text/css
</FilesMatch>

<FilesMatch "\.js$">
  ForceType application/javascript
</FilesMatch>
# ------------------------------------------------------------

